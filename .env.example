# Copy to .env and fill in. Never commit the real file.
#
# In production these are set in the Vercel dashboard, NOT here. Vercel injects
# environment variables at BUILD time, so changing one requires a redeploy
# before the running deployment can see it.

# ─── Database (required) ──────────────────────────────────────────────────────
# A Neon (or any PostgreSQL) connection string. The pooled URL is the right one
# for serverless: functions open many short-lived connections, which is what a
# pooler is for.
#
# The aliases below are what the Neon and Vercel Postgres integrations
# provision; the server accepts any of them, so a project wired up through the
# marketplace works without renaming anything.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# DATABASE_URL_UNPOOLED=
# POSTGRES_URL_NON_POOLING=

# ─── Origins allowed to call the API with credentials (required in production) ─
# Comma-separated. "*" is ignored: browsers refuse a wildcard origin alongside
# credentials, so the session cookie would never be sent. localhost:5173 and
# :4173 are always allowed and do not need listing.
CORS_ORIGIN=https://budgeting-app-peach-iota.vercel.app

# Vercel gives every preview deployment a generated subdomain, so previews
# cannot be listed ahead of time. Set to "true" to allow *.vercel.app.
# CORS_ALLOW_VERCEL_PREVIEWS=false

# ─── Public URL, used to build password-reset links ───────────────────────────
# Deliberately never taken from the Host or Referer header: those are
# attacker-controlled, and a reset link built from them would deliver a valid
# one-time token to a domain of the attacker's choosing. Falls back to the first
# CORS_ORIGIN entry.
# PUBLIC_APP_URL=https://budgeting-app-peach-iota.vercel.app

# ─── Email delivery for password resets (optional) ────────────────────────────
# Without a key, /api/auth/forgot-password still answers normally — its response
# must not depend on whether mail was sent, or it becomes a way to discover
# which addresses have accounts. In development the link is logged instead.
# The sender domain must be verified in Resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Budget App <budget@yourdomain.com>

# ─── Signup gate (optional) ───────────────────────────────────────────────────
# When set, creating an account requires this code. Leave unset for open signup.
# SIGNUP_INVITE_CODE=

# ─── Tuning (optional) ────────────────────────────────────────────────────────
# scrypt cost as a power of two; 10–20, default 15. Lowered only in tests, where
# hashing many passwords at full cost would dominate the run time.
# PASSWORD_SCRYPT_COST=15

# ─── Local development ────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Where `vite dev` proxies /api. Point it at a local server on another port when
# running one by hand.
# VITE_API_PROXY_TARGET=http://localhost:3001

# ─── Tests ────────────────────────────────────────────────────────────────────
# A DISPOSABLE database. The integration suites create and drop schemas in it,
# and they are skipped entirely when this is unset — which silently reduces
# coverage to the unit tests, so set it when running them locally.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/budget_test
